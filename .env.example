# ==============================================================================
# ResumeMatch: Environment Configuration Template (.env.example)
# Copy this file to .env and customize values for your local environment.
# ==============================================================================

# --- Application Core ---
ENVIRONMENT=development
PROJECT_NAME="ResumeMatch"
API_V1_STR="/api/v1"
BACKEND_URL="http://localhost:8000"
SECRET_KEY=change-this-to-a-super-secret-high-entropy-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database Configuration ---
# Primary Architecture: PostgreSQL + pgvector (Development via Docker Desktop & Production)
# Configurable profiles:
#   - 'postgres_pgvector' (PRIMARY: Required for production, pgvector embeddings, and relational integrity)
#   - 'local_sqlite'     (OPTIONAL: Lightweight test/local fallback only, isolated behind data access layer)
DATABASE_PROFILE=postgres_pgvector

# Primary PostgreSQL + pgvector Database URL
DATABASE_URL="postgresql+asyncpg://resumematch_user:resumematch_password@localhost:5432/resumematch"

# PostgreSQL Server Parameters (Docker Desktop / Production)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=resumematch_user
POSTGRES_PASSWORD=resumematch_password
POSTGRES_DB=resumematch

# Optional Test/Local Fallback (Only active if DATABASE_PROFILE=local_sqlite)
SQLITE_DB_PATH="sqlite+aiosqlite:///./resumematch.db"

# --- AI / Embedding Model Settings ---
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_DIMENSION=384
MAX_TOKEN_CHUNK_SIZE=512
CHUNK_STRIDE=128

# --- Scoring Engine Weights (Must sum to 1.00) ---
WEIGHT_SEMANTIC=0.50
WEIGHT_SKILLS=0.30
WEIGHT_EXPERIENCE=0.10
WEIGHT_EDUCATION=0.10

# --- File Ingestion & Security ---
MAX_UPLOAD_SIZE_BYTES=5242880 # 5 MB
ALLOWED_FILE_TYPES=["application/pdf"]
MAX_PDF_PAGES=10

# --- CORS & Networking ---
# Allowed frontend origins. In production, specify verified domain(s), e.g. ["https://app.resumematch.ai"].
# Wildcard '*' is strictly prohibited for security.
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Frontend Networking & API URLs (Next.js) ---
# Browser-facing API endpoint (used by client-side browser fetches)
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000/api/v1"

# Docker-internal API endpoint (used by Next.js server components / route handlers)
# Local development without Docker: leave as "http://localhost:8000/api/v1"
# Docker Compose full-stack: "http://backend:8000/api/v1"
INTERNAL_API_BASE_URL="http://localhost:8000/api/v1"
