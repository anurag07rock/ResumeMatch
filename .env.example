# ==============================================================================
# ResumeMatch: Environment Configuration Template (.env.example)
# Copy this file to .env and customize values for your local environment.
# ==============================================================================

# --- Application Core ---
ENVIRONMENT=development
PROJECT_NAME="ResumeMatch"
API_V1_STR="/api/v1"
BACKEND_URL="http://localhost:8000"
SECRET_KEY=change-this-to-a-super-secret-high-entropy-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database Configuration ---
# Options: 'local_sqlite' (zero-dependency local development) or 'postgres_pgvector' (production/Docker)
DATABASE_PROFILE=local_sqlite

# Default / Primary Database URL Placeholder
DATABASE_URL="postgresql+asyncpg://resumematch_user:resumematch_password@localhost:5432/resumematch"

# Local SQLite (Development Fallback)
SQLITE_DB_PATH="sqlite+aiosqlite:///./resumematch.db"

# PostgreSQL + pgvector (Docker / Production Credentials)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=resumematch_user
POSTGRES_PASSWORD=resumematch_password
POSTGRES_DB=resumematch

# --- AI / Embedding Model Settings ---
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_DIMENSION=384
MAX_TOKEN_CHUNK_SIZE=512
CHUNK_STRIDE=128

# --- Scoring Engine Weights (Must sum to 1.00) ---
WEIGHT_SKILLS=0.40
WEIGHT_SEMANTIC=0.35
WEIGHT_EXPERIENCE=0.15
WEIGHT_EDUCATION=0.10

# --- File Ingestion & Security ---
MAX_UPLOAD_SIZE_BYTES=5242880 # 5 MB
ALLOWED_FILE_TYPES=["application/pdf"]
MAX_PDF_PAGES=10

# --- CORS & Networking ---
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Frontend Settings (Next.js) ---
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
